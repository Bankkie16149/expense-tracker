# -------------------------------------------------------------
# FinTrack Backend Environment Configuration
# -------------------------------------------------------------

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon Postgres / Local Postgres)
DATABASE_URL=postgresql://expense_user:securepassword123@localhost:5432/expense_tracker?schema=public

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
ADMIN_EMAIL=admin@fintrack.app

# Cron & Background Jobs
CRON_SECRET=fintrack_cron_secure_token

# Email Delivery (Brevo / SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# =============================================================
# GRAFANA CLOUD OBSERVABILITY CONFIGURATION
# =============================================================

# --- Method 1: OpenTelemetry (OTLP) All-in-One (Metrics + Traces) [RECOMMENDED] ---
# Found in Grafana Cloud Portal -> Your Stack -> "OpenTelemetry" or "Send Data" -> "OpenTelemetry"
# Example Endpoint: https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Format: Authorization=Basic <base64(instance_id:api_token)>
OTEL_EXPORTER_OTLP_HEADERS=

# Alternatively, you can supply Instance ID and API Token separately (auto-builds Basic Auth header):
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=

# Service identifiers in Grafana
OTEL_SERVICE_NAME=fintrack-backend
OTEL_SERVICE_NAMESPACE=production
OTEL_METRIC_EXPORT_INTERVAL=15000

# --- Method 2: Grafana Loki Direct Log Streaming (Winston) ---
# Found in Grafana Cloud Portal -> Your Stack -> Loki Card details
# Example Host: https://logs-prod-006.grafana.net
GRAFANA_LOKI_HOST=
# Loki User / Instance ID (Number, e.g. 372040)
GRAFANA_LOKI_USER=
# Grafana Cloud Access Policy Token with 'logs:write' scope
GRAFANA_LOKI_TOKEN=
